# ---------------------------------
# WordPress Core (ignore completely)
# ---------------------------------
/wp-admin/
/wp-includes/
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html
/index.php

# Config
wp-config.php

# ---------------------------------
# wp-content rules
# ---------------------------------

# Block everything in wp-content except allowed files
wp-content/*
!wp-content/themes/
!wp-content/mu-plugins/

# Ignore plugins folder entirely
wp-content/plugins/

# Ignore uploads & generated files
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/languages/
wp-content/updraft/

# ---------------------------------
# Theme Handling — ALLOW ONLY YOUR THEME
# ---------------------------------
# Deny all themes by default
wp-content/themes/*

# ✅ Replace "your-theme-name" with your actual theme folder
!wp-content/themes/Alceon/

# ---------------------------------
# Misc
# ---------------------------------
*.log
*.sql
*.sql.gz
.DS_Store
.env
/vendor/
node_modules/


# System
.DS_Store

# IDE
*.sublime-workspace
*.sublime-project
.vscode/
.idea/

# Node
node_modules/

# Build outputs
wp-content/themes/*/css/
wp-content/themes/*/js/
*.map

# Zip archives
*.zip

# Understrap core (if using child theme)
wp-content/themes/understrap/
wp-content/themes/Child_Theme/
